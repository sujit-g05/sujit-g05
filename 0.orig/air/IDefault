FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    location    "0/air";
    object      IDefault;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 0 -3 0 0 0 0];
internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            greyDiffusiveRadiation;
        value           uniform 0;
        emissivityMode  lookup;
        emissivity      1;
    }
    outlet
    {
        type            greyDiffusiveRadiation;
        value           uniform 0;
        emissivityMode  lookup;
        emissivity      1;
    }
    topAndBottom
    {
        type            greyDiffusiveRadiation;
        value           uniform 0;
        emissivityMode  lookup;
        emissivity      1;
    }
    frontAndBack
    {
        type            greyDiffusiveRadiation;
        value           uniform 0;
        emissivityMode  lookup;
        emissivity      1;
    }
    ".*"
    {
        type            greyDiffusiveRadiation;
        value           uniform 0;
        emissivityMode  solidRadiation;
    }
}
