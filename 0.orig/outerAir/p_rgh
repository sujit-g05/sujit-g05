FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];
internalField   uniform 100000;
boundaryField
{

    frontAndBack { type empty; }
    inlet { type zeroGradient; }
    outlet { type fixedValue; value uniform 100000; }
    outerBoundary { type zeroGradient; }
    ".*" { type zeroGradient; }

}
