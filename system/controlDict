FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamMultiRun;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         10; // short for testing
deltaT          1e-5;
maxCo           1.0;
maxDi           1.0;
writeControl    adjustableRunTime;
writeInterval   0.1;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

modules
(
    fluid
    {
        type fluid;
        regions (innerAir outerAir);
    }
    solid
    {
        type solid;
        regions (heater cylinder);
    }
);

functions
{
}
