FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamMultiRun;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         600;
deltaT          0.001;
adjustTimeStep  yes;
maxCo           1.0;
maxAlphaCo      1.0;
writeControl    timeStep;
writeInterval   1000;
purgeWrite      0;
writeFormat     ascii;
writePrecision  6;
writeCompression off;
timeFormat      general;
timePrecision   6;
runTimeModifiable true;

modules
(
    {
        name fluid;
        type fluidMultiRegion;
        regions (innerAir outerAir);
    }
    {
        name solid;
        type solidMultiRegion;
        regions (heater cylinder glass);
    }
);

functions
{
    probes_cylinder
    {
        type            probes;
        libs            ("libsampling.so");
        region          cylinder;
        fields          (T);
        probeLocations
        (
            (-0.14 -0.0745 0.05) // 1 (bottom inner)
            ( 0.14 -0.0745 0.05) // 2
            (-0.14  0.0745 0.05) // 3 (top inner)
            ( 0.14  0.0745 0.05) // 4
            (-0.14  0.0749 0.05) // 5 (top outer)
            ( 0.14  0.0749 0.05) // 6
            (-0.14 -0.0749 0.05) // 7 (bottom outer)
            ( 0.14 -0.0749 0.05) // 8
        );
    }
    probes_innerAir
    {
        type            probes;
        libs            ("libsampling.so");
        region          innerAir;
        fields          (T);
        probeLocations
        (
            (0  0.0383 0.05) // 9
            (0 -0.0383 0.05) // 10
        );
    }
    surfaces_cylinder
    {
        type            surfaces;
        libs            ("libsampling.so");
        region          cylinder;
        writeControl    timeStep;
        writeInterval   1000;
        surfaceFormat   vtk;
        fields          (T);
        interpolationScheme cellPoint;
        surfaces
        (
            upper_surface
            {
                type            plane;
                planeType       pointAndNormal;
                pointAndNormalDict
                {
                    point   (0 0.075 0.05);
                    normal  (0 1 0);
                }
            }
            lower_surface
            {
                type            plane;
                planeType       pointAndNormal;
                pointAndNormalDict
                {
                    point   (0 -0.075 0.05);
                    normal  (0 -1 0);
                }
            }
        );
    }
}
