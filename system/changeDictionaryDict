FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "system";
    object      changeDictionaryDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dictionaryReplacement
{
    U
    {
        internalField   uniform (1 0 0);
        boundaryField
        {
            ".*"
            {
                type            noSlip;
            }
            "inlet"
            {
                type            fixedValue;
                value           uniform (1 0 0);
            }
            "outlet"
            {
                type            inletOutlet;
                inletValue      uniform (0 0 0);
                value           uniform (1 0 0);
            }
            "topAndBottom"
            {
                type            slip;
            }
            "frontAndBack"
            {
                type            slip;
            }

            // Coupled boundaries will be set by splitMeshRegions/changeDictionary automatically if configured
            // Or we just leave them. The solver requires compressible::turbulentTemperatureCoupledBaffleMixed for T.
            // But doing that properly requires a changeDictionary for EVERY region.
        }
    }
}
