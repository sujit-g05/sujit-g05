FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    location    "constant";
    object      radiationProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

radiation       on;
radiationModel  fvDOM;

fvDOMCoeffs
{
    nPhi        2;
    nTheta      2;
    tolerance   1e-3;
    maxIter     10;
}
