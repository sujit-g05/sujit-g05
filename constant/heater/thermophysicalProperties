FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      thermophysicalProperties;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

thermoType
{
    type            heSolidThermo;
    mixture         pureMixture;
    transport       constIso;
    thermo          eConst;
    equationOfState rhoConst;
    specie          specie;
    energy          sensibleInternalEnergy;
}
mixture
{
    specie
    {
        nMoles      1;
        molWeight   12; // dummy
    }
    equationOfState
    {
        rho         7250;
    }
    transport
    {
        kappa       11;
    }
    thermodynamics
    {
        Hf          0;
        Cv          460;
    }
}
